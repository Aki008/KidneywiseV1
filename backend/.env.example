# Server Configuration
NODE_ENV=development
PORT=8080
API_VERSION=v1

# Database
DATABASE_URL=postgresql://dev:devpass@localhost:5432/kidneywise_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kidneywise_dev
DB_USER=dev
DB_PASSWORD=devpass
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=org-your-org-id

# LogMeal API
LOGMEAL_API_KEY=your-logmeal-api-key
LOGMEAL_API_URL=https://api.logmeal.es/v2

# Google Cloud Vision (for OCR)
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# AWS Services
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=kidneywise-photos-dev
AWS_S3_BUCKET_LABS=kidneywise-labs-dev

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key

# Email (for notifications - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@kidneywise.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=KidneyWise <noreply@kidneywise.com>

# Feature Flags
ENABLE_MYCHART_INTEGRATION=false
ENABLE_VOICE_COMMANDS=true
ENABLE_LAB_OCR=true

# Monitoring
SENTRY_DSN=your-sentry-dsn
